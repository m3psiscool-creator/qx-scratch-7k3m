<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- the parser only looks for export classes in assemblies whose name contains ReplayReader -->
    <AssemblyName>LandingsReplayReader</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The replay parser (https://github.com/Shiqan/FortniteReplayDecompressor, GPL-3.0) is cloned next to this folder by the workflow / setup script. -->
    <ParserProject Condition="'$(ParserProject)' == ''">..\..\parser\src\FortniteReplayReader\FortniteReplayReader.csproj</ParserProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ParserProject)" />
  </ItemGroup>
</Project>
